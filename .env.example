# ==========================================
# WoW Argentina CMS - Variables de Entorno
# NUNCA usar root en producción. Crear usuario cms con permisos limitados.
# ==========================================

# Base de datos AzerothCore (usuario cms con SELECT en auth, READ en characters)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=cms_web
DATABASE_PASSWORD=CAMBIAR_ESTO

# DBs de AzerothCore
DATABASE_AUTH=acore_auth
DATABASE_CHARACTERS=acore_characters
DATABASE_WORLD=acore_world

# DB CMS propia
DATABASE_CMS=wowargentina_cms

# Realm usado para account_access.RealmID y rbac_account_permissions.realm_id (además de -1)
REALM_ID=1

# El acceso a /directivos se gestiona en wowargentina_cms.wowargentina_directivos
# (ver migrations/2026_11_wowargentina_directivos.sql). No depende de gmlevel ni RBAC.

# JWT Secret (mínimo 64 chars random)
JWT_SECRET=CAMBIAR_ESTO_POR_STRING_RANDOM_64_CHARS

# SOAP AzerothCore (worldserver)
SOAP_HOST=127.0.0.1
SOAP_PORT=7878
SOAP_USER=SOAP_ADMIN_ACCOUNT
SOAP_PASS=CAMBIAR_ESTO

# Panel GM — estado real del servidor
# Authserver: se verifica con una conexión TCP al puerto de autenticación.
AUTH_HOST=127.0.0.1
AUTH_PORT=3724
# Worldserver: se verifica con ".server info" por SOAP. WORLD_PORT es opcional
# (si se define, además se comprueba que el puerto de juego acepte conexiones).
WORLD_HOST=127.0.0.1
# WORLD_PORT=8085

# Panel GM — país por IP (opcional). Ruta a GeoLite2-Country.mmdb de MaxMind.
# Sin este archivo las cuentas se muestran como "País desconocido".
# GEOIP_DB_PATH=/var/lib/GeoIP/GeoLite2-Country.mmdb

# App
NEXT_PUBLIC_SITE_URL=https://wowargentina.com.ar
NEXT_PUBLIC_REALM_NAME=WoW Argentina
NEXT_PUBLIC_REALMLIST=logon.wowargentina.com.ar
NODE_ENV=production

# Rate limiting (opcional - Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
